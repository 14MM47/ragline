# Runtime state — uploaded documents, SQLite DB, session memory JSON files.
data/

# Secrets — real environment files must never be committed.
# Glob covers .env, .env.openai.bak, .env.local, etc. (env.template has no
# leading dot, so it stays tracked).
.env*

# Python build/runtime artifacts.
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/

# Test / tooling caches.
.pytest_cache/
.ruff_cache/

# Frontend build output and dependencies.
frontend/node_modules/
frontend/dist/

# The test corpus — vendor PDFs are fetched (scripts/fetch_corpus.py), never
# committed; eval/corpus/ holds the index instead.
testdata/
*.pdf
*.part

# Local ingest/eval scratch logs (recorded runs live in eval/results/).
eval/ingest-*.log

# Editor / assistant / OS noise.
.vscode/
.idea/
.claude/
.DS_Store
*:Zone.Identifier
# Campaign runner logs: subprocess output, kept local even though results are published.
eval/results/**/campaign.log

# Evaluation transcripts (full prompts, responses, reasoning) — kept out of git and
# archived off-machine by scripts/eval_archive.py (docs/eval/call-capture-plan.md).
eval/results/**/*.transcripts.jsonl.gz
# Detached campaign-runner output and pid files.
eval/results/**/runner-*.out
eval/results/**/runner.pid
