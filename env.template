# env.template — full configuration surface for ragline.
# Copy to .env and fill in values:   cp env.template .env
# (Named env.template rather than .env.example so tooling that guards .env*
# paths leaves it alone.)
# Every setting here maps 1:1 to a field in src/ragline/config.py.
#
# AS COPIED, this file boots a LOCAL SINGLE-USER instance: auth off, one "dev"
# identity, meant to be reached on 127.0.0.1 only (restart.sh binds loopback).
# The only thing you must fill in is the model endpoint — the three LLM_* lines
# below, plus the EMBEDDING_* / RERANKER_* lines when those live on other ports
# (they do on a rented GPU pod; see docs/gpu-pod.md).

# ============================================================================
# LLM endpoint — ONE OpenAI-compatible endpoint used for EVERYTHING:
# chat answers, knowledge-graph extraction, structured pre-pass, memory
# post-pass, and the confidence scorer.
#
# Swapping the stack under test is an edit to these three lines, no code change:
#   1. Rented pod (vLLM): LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
#   2. OpenAI cloud:      LLM_BASE_URL=https://api.openai.com/v1
#   3. Azure OpenAI:      LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   4. Your own vLLM:     LLM_BASE_URL=http://<host>:8000/v1
# LLM_MODEL is whatever name the endpoint serves (vLLM: --served-model-name).
# ============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ============================================================================
# Embeddings — same OpenAI-compatible API shape. These DEFAULT TO THE LLM
# VALUES above when left empty, because on OpenAI cloud one endpoint serves
# both. When self-hosting, a vLLM instance serves ONE model, so the embedding
# model will live on its own port — set these to point at it.
# ============================================================================
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
# Some self-hosted servers need the output dimension pinned explicitly.
# Leave empty to use the model's native dimension.
EMBEDDING_DIMENSIONS=
# Qwen3-Embedding ONLY: task instruction prepended to queries (not documents)
# as "Instruct: <this>\nQuery:<query>". Qwen reports a ~1-5% retrieval drop
# without one. Leave EMPTY for OpenAI or any non-instruction embedder.
# Changing it needs no re-index. Value used for the recorded eval runs:
# EMBEDDING_QUERY_INSTRUCTION=Given a technical question about industrial automation products, retrieve datasheet passages that answer it
EMBEDDING_QUERY_INSTRUCTION=

# ============================================================================
# Reranker — the ONE component not behind the OpenAI-compatible endpoint,
# because the OpenAI API has no rerank operation.
#   local = CPU cross-encoder inside this process (default; downloads ~2GB of
#           weights on first start, then works fully offline)
#   api   = cross-encoder on a GPU pod behind a rerank endpoint (set
#           RERANKER_BASE_URL + RERANKER_API_FORMAT below; RERANKER_MODEL is
#           then ignored — the endpoint decides the model)
#   none  = skip reranking entirely (dense+BM25 fusion order is used as-is;
#           quickest first boot)
# ============================================================================
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Only used when RERANKER_PROVIDER=api — the reranker server root (no trailing /).
RERANKER_BASE_URL=
RERANKER_API_KEY=
# Only used when RERANKER_PROVIDER=api — the endpoint's wire format:
#   tei    = TEI native /rerank (bge-reranker-v2-m3 on TEI)
#   cohere = /v1/rerank as served by vLLM (Qwen3-Reranker, zerank-2)
RERANKER_API_FORMAT=tei
# Skip the (slow) cross-encoder when dense scores already show a clear winner:
# top score >= MIN_TOP_SCORE and (top - mean of rest) >= SCORE_GAP.
RERANKER_SKIP_SCORE_GAP=0.25
RERANKER_SKIP_MIN_TOP_SCORE=0.5

# ============================================================================
# Vector store (Qdrant) — run via `docker compose up -d qdrant`.
# Changing embedder needs a new collection AND separate DATABASE_URL,
# UPLOAD_DIR and MEMORY_DIR before re-ingesting; see docs/gpu-pod.md.
# ============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ragline

# ============================================================================
# Storage — SQLite metadata DB, uploaded-file store, session memory files.
# All under ./data/ which is gitignored.
#
# Intranet VM / systemd (experimental — deploy/intranet/): use ABSOLUTE paths
# so no process depends on its working directory — the app, the ACL crawler, and CLI scripts all read this
# file. Example:
#   DATABASE_URL=sqlite+aiosqlite:////opt/ragline/data/ragline.db
#   UPLOAD_DIR=/opt/ragline/data/uploads
#   MEMORY_DIR=/opt/ragline/data/memory
#   FRONTEND_DIST=/opt/ragline/frontend/dist
# ============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/ragline.db
UPLOAD_DIR=./data/uploads
MEMORY_DIR=./data/memory
# Built SPA directory served at / (relative default suits dev from the repo root).
FRONTEND_DIST=frontend/dist

# ============================================================================
# Auth.
#
# LOCAL SINGLE-USER (what this template ships): AUTH_ENABLED=false plus the
# RAGLINE_ALLOW_INSECURE_DEV=1 interlock. Every request then runs as one
# admin-capable "dev" identity with NO login — safe only because restart.sh
# binds 127.0.0.1. Do not expose the port (see SECURITY.md).
#
# MULTI-USER (EXPERIMENTAL, not production-validated — deploy/intranet/):
# Entra SSO via backend-for-frontend OIDC. Sign-in happens on
# login.microsoftonline.com; ragline never sees a password. Users get an
# opaque HttpOnly session cookie; identity/groups live server-side. Set
# AUTH_ENABLED=true, BLANK the interlock, and fill the ENTRA_* / SESSION_SECRET
# / APP_BASE_URL values — startup aborts loudly if any are missing. Note the
# code default (no .env at all) is AUTH_ENABLED=true: it fails closed.
#
# App registration (single tenant): Web platform, redirect URI
#   {APP_BASE_URL}/api/auth/callback
# Token configuration: groups claim = "Security groups" as "Group IDs" in the
# ID token. Delegated permissions: openid profile email offline_access
# User.Read (offline_access powers silent session re-validation — without it
# users are forced to re-login every SESSION_REVALIDATE_MINUTES).
# Application permission GroupMember.Read.All (admin consent) is ONLY needed
# for the >200-group overage fallback — if nobody in the tenant exceeds 200
# security groups, DON'T grant it: it is a standing tenant-wide permission
# and the client secret becomes a much less valuable theft target without it.
# ============================================================================
AUTH_ENABLED=false
# Safety interlock: with AUTH_ENABLED off (any of false/0/no/off), the app
# REFUSES to start unless this is set to 1 — so a shared box can never serve
# the corpus unauthenticated by a config slip. Set it ONLY on a local machine,
# alongside AUTH_ENABLED=false. Blank it on anything other people can reach.
RAGLINE_ALLOW_INSECURE_DEV=1
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Members of this security group see admin surfaces (ACL crawl status).
# Empty = no admins.
ENTRA_ADMIN_GROUP_ID=
# Long random string; signs the session cookie AND the short-lived login-dance
# cookie. Rotating it signs every user out at once. e.g. `openssl rand -hex 32`
SESSION_SECRET=
# External base URL users hit, e.g. https://ragline.corp.example — used to
# build the OIDC redirect URI, so it must match the app registration exactly.
APP_BASE_URL=
SESSION_IDLE_HOURS=12       # sliding window: idle longer than this = signed out
SESSION_ABSOLUTE_DAYS=7     # hard cap regardless of activity
# Revocation-lag bound: live sessions silently re-validate against Entra this
# often (refresh grant). A disabled account / revoked sign-in session dies
# within this window instead of surviving to session expiry.
SESSION_REVALIDATE_MINUTES=60
# true = signing out of ragline also ends the Entra browser session (needed
# on shared/kiosk machines; leave false on personal devices).
LOGOUT_FROM_ENTRA=false
# File-based secret variants (systemd LoadCredential= / docker secrets).
# When set, the FILE'S CONTENTS are used and the inline value above can stay
# empty — keeps secrets out of .env entirely. See deploy/intranet/systemd/ragline.service.
ENTRA_CLIENT_SECRET_FILE=
SESSION_SECRET_FILE=
SMB_PASSWORD_FILE=

# ============================================================================
# ACL crawler (EXPERIMENTAL, multi-user only — ignored with auth off).
# Reads each ingested file's NTFS DACL over SMB (systemd timer,
# scripts/acl_crawl.py) and gates the citation "Open copy" link + original
# path per user. Retrieval stays global; only source links are gated. FAIL
# CLOSED: blank/unreachable paths, stale crawls (> ACL_STALE_DAYS), and
# unresolvable SIDs all deny.
#
# Service account: read + READ_CONTROL (the NTFS "Read" role) and share-level
# Read on every ingested share. No write. Validate the whole setup with
# `uv run python scripts/acl_spike.py '\\host\share\file.pdf'` BEFORE
# enabling the timer.
# ============================================================================
SMB_USERNAME=
SMB_PASSWORD=
# Fold host aliases so \\fs1\eng and \\fs1.corp.example\eng key identically:
# SMB_HOST_ALIASES=fs1=fs1.corp.example;nas=nas01.corp.example
SMB_HOST_ALIASES=
ACL_STALE_DAYS=7            # crawl older than this grants nothing
GROUPS_CACHE_TTL_HOURS=24   # user group-membership cache lifetime

# ============================================================================
# Retrieval tuning.
# ============================================================================
RETRIEVAL_TOP_K=20          # candidates fetched by hybrid search before rerank
RERANK_TOP_K=8              # chunks that survive reranking into the LLM prompt
ENABLE_CONTEXT_REORDERING=true  # lost-in-the-middle mitigation (best chunks at edges)
ENABLE_HYDE=false           # reserved: accepted but unused (no HyDE code path)

# ============================================================================
# Chunking / parsing.
# ============================================================================
CHUNK_MAX_TOKENS=512        # token budget per chunk (tiktoken, gpt-4o encoding)
CHUNK_OVERLAP_FRACTION=0.15 # fraction of each chunk repeated into the next
ENABLE_LAYOUT_ANALYSIS=true # strip repeated page headers/footers (datasheets!)
ENABLE_OCR_FALLBACK=true    # OCR pages with <50 chars of extracted text
                            # (requires the [ocr] extra + tesseract binary)

# ============================================================================
# Knowledge graph — LLM entity/relationship extraction at ingest time,
# graph-augmented retrieval at query time.
# ============================================================================
ENABLE_KNOWLEDGE_GRAPH=true
KG_EXTRACTION_CONCURRENCY=20  # parallel LLM extraction calls during ingestion
KG_EXTRACTION_MAX_TOKENS=2048 # output cap per extraction call; bounds runaway generations

# ============================================================================
# Chat behaviour.
# ============================================================================
USE_STRUCTURED_PREPASS=true # JSON pre-pass: query rewrite + routing in one call
ENABLE_CONFIDENCE=true      # post-answer confidence score (one cheap LLM call)
MEMORY_TOKEN_BUDGET=1500    # max tokens of conversation memory injected per turn
INTENT_CLASSIFIER=keyword   # library-mode detection: "keyword" (no LLM cost)

# ============================================================================
# Ingestion.
# ============================================================================
BATCH_MAX_PARALLEL=3        # documents processed concurrently within a batch
BATCH_MAX_FILES=1000        # hard cap on files per batch upload
# Server-side folder ingest (GUI "Ingest server folder" panel): ";"-separated
# allowlist of directories /api/batches/ingest-path may read. EMPTY = the
# endpoint is DISABLED (it reads server-local files by path, so it is an
# explicit operator opt-in). Example: INGEST_ROOTS=/srv/corpora;/mnt/shares/eng
INGEST_ROOTS=

# ============================================================================
# Logging.
# ============================================================================
LOG_LEVEL=info
